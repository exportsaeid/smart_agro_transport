<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Smart Agro Transport</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>smart_agro_transport</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	
	<!-- ============================================================ -->
	<!-- مجوزهای مورد نیاز برنامه -->
	<!-- ============================================================ -->
	
	<!-- مجوز دوربین (برای عکس گرفتن) -->
	<key>NSCameraUsageDescription</key>
	<string>برای افزودن عکس به پیوست‌های فاکتور به دوربین نیاز داریم</string>
	
	<!-- مجوز گالری (برای انتخاب تصویر) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>برای انتخاب تصویر از گالری و افزودن به پیوست‌های فاکتور</string>
	
	<!-- مجوز ذخیره‌سازی (برای ذخیره PDF و فایل‌ها) -->
	<key>NSFilesProviderUsageDescription</key>
	<string>برای ذخیره فایل‌های PDF و پیوست‌ها</string>
	
	<!-- مجوز موقعیت مکانی (برای نقشه) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>برای نمایش موقعیت شما روی نقشه به دسترسی نیاز داریم</string>
	
	<key>NSLocationAlwaysUsageDescription</key>
	<string>برای نمایش موقعیت شما روی نقشه به دسترسی نیاز داریم</string>
	
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>برای نمایش موقعیت شما روی نقشه به دسترسی نیاز داریم</string>
	
	<!-- مجوز میکروفون -->
	<key>NSMicrophoneUsageDescription</key>
	<string>برای ضبط صدا (در صورت نیاز)</string>
	
	<!-- ============================================================ -->
	<!-- تنظیمات Google Maps برای iOS -->
	<!-- ============================================================ -->
	<key>io.flutter.embedded_views_preview</key>
	<true/>
	
	<!-- ============================================================ -->
	<!-- تنظیمات Launch Screen -->
	<!-- ============================================================ -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	
	<!-- ============================================================ -->
	<!-- تنظیمات چرخش صفحه -->
	<!-- ============================================================ -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<!-- ============================================================ -->
	<!-- تنظیمات دیگر -->
	<!-- ============================================================ -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	
	<!-- برای پشتیبانی از فونت‌های فارسی -->
	<key>UIAppFonts</key>
	<array>
		<string>vazir_regular.ttf</string>
		<string>vazir_bold.ttf</string>
		<string>bnazanin_regular.ttf</string>
		<string>bnazaninr_bold.ttf</string>
	</array>
	
	<!-- برای پشتیبانی از HTTP (در صورت نیاز) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>